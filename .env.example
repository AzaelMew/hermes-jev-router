# Jev key. The installer never copies your real key.
JEV_API_KEY=jev_replace_me

# Key Hermes sends to the localhost provider. This can be any local-only value.
JEV_ROUTER_API_KEY=local-router
JEV_ROUTER_BASE_URL=http://127.0.0.1:8765/v1

# Use 1 for a local rehearsal. Set to 0 for real downstream model calls.
JEV_ROUTER_DEMO=1

# Native Hermes mode discovers its own model catalog.
# Use this only for the standalone sidecar or the later OpenClaw adapter.
# JEV_ROUTER_ROUTES_FILE=/absolute/path/to/routes.json

